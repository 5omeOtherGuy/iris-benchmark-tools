/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/requirements-harbor.txt
!/SECURITY.md
!/agents/
!/agents/iris_installed.py
!/analyze_tokens.py
!/fixtures/
!/fixtures/iris_usage.v2.json
!/run-bench.sh
!/scripts/
!/scripts/check-no-secrets.sh
!/scripts/gate
!/test_analyze_tokens.py
!/test_benchmark_onboarding.py
!/test_repository_security.py
!/.agents/
!/.agents/setup
!/.agents/skills/
!/.agents/skills/*/
!/.agents/skills/*/SKILL.md
!/.agents/skills/*/agents/
!/.agents/skills/*/agents/openai.yaml
!/.agents/skills/*/scripts/
!/.agents/skills/*/scripts/*.py
!/.claude/
!/.claude/skills/
!/.claude/skills/*
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/dependabot.yml

# Never publish benchmark payloads, credentials, or local binaries.
**/secrets.env
**/.env*
!**/.env.example
**/*.credentials.json
**/auth.json
**/.benchmark-setup
**/.benchmark-cache/
**/jobs/
**/assets/
**/.eda-archives/
**/__pycache__/
**/*.py[cod]
**/*.tar
**/*.tar.gz
**/*.zip

# Local scratch and editor files.
**/.amp/in/
**/.venv/
**/.idea/
**/.vscode/
**/*.swp
**/.DS_Store
