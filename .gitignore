/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/LICENSE-APACHE
!/README.md
!/SECURITY.md
!/agents/
!/agents/iris_installed.py
!/analyze_tokens.py
!/fixtures/
!/fixtures/iris_usage.v2.json
!/run-bench.sh
!/scripts/
!/scripts/check-no-secrets.sh
!/test_analyze_tokens.py
!/test_repository_security.py
!/.agents/
!/.agents/skills/
!/.agents/skills/*/
!/.agents/skills/*/SKILL.md
!/.claude/
!/.claude/skills/
!/.claude/skills/*
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml

# Never publish benchmark payloads, credentials, or local binaries.
**/secrets.env
**/.env
**/*.credentials.json
**/auth.json
**/jobs/
**/assets/
**/.eda-archives/
**/__pycache__/
**/*.py[cod]
**/*.tar
**/*.tar.gz
**/*.zip
